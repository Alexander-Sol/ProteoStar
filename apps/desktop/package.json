{
  "name": "@msbrowser/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "e2e:app": "tauri dev --features e2e-testing",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:browser": "playwright test --config e2e/playwright.config.ts --project=browser",
    "e2e:tauri": "playwright test --config e2e/playwright.config.ts --project=tauri"
  },
  "dependencies": {
    "@msbrowser/plot-adapter": "workspace:*",
    "@msbrowser/ui": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "apache-arrow": "^18.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@srsholmes/tauri-playwright": "^0.4.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.2",
    "vite": "^6.0.0"
  }
}
