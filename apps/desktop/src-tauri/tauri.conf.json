{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MsViewer",
  "version": "0.0.0",
  "identifier": "com.msbrowser.msviewer",
  "build": {
    "beforeDevCommand": "bunx vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bunx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MsViewer",
        "width": 1280,
        "height": 860
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
