{
  "name": "proteostar",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/desktop && bun run dev",
    "tauri": "cd apps/desktop && bun run tauri",
    "build": "cd apps/desktop && bun run build",
    "test": "vitest run",
    "typecheck": "./node_modules/.bin/tsc -p packages/plot-adapter/tsconfig.json --noEmit && ./node_modules/.bin/tsc -p packages/ui/tsconfig.json --noEmit && ./node_modules/.bin/tsc -p apps/desktop/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.4.0",
    "@types/plotly.js": "^3.0.7",
    "@types/react-plotly.js": "^2.6.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
